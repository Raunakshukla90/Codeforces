#include <bits/stdc++.h>
using namespace std;
 
int main()
{
    int t;
    cin >> t;
    while (t--)
    {
        long long n, k;
        cin >> n >> k; //size of the array and the integer k
        long long a[n];
        for (int i = 0; i < n; i++) 
            cin >> a[i];
        // Input array elements
 
        long long number_is_present = 0; // Flag to check if k is present in the array
        for (int i = 0; i < n; i++) 
        {
            if (a[i] == k) // Check if the current element is equal to k
            {
                number_is_present = 1; // Set flag to true if k is found
                break; 
            }
        }
 
        if (number_is_present) 
            cout << "YES" << endl;
        else
            cout << "NO" << endl; 
    }
    return 0;
}